Window.SetBackgroundTopColor(0.02, 0.04, 0.09);
Window.SetBackgroundBottomColor(0.02, 0.04, 0.09);

sw = Window.GetWidth();
sh = Window.GetHeight();

# frames are 16:9 (960x540); cover the screen
first = Image("f000.png");
r = Math.Max(sw / first.GetWidth(), sh / first.GetHeight());
nw = Math.Int(first.GetWidth() * r) + 1;
nh = Math.Int(first.GetHeight() * r) + 1;
ox = Window.GetX() + (sw - nw) / 2;
oy = Window.GetY() + (sh - nh) / 2;

sprite = Sprite();
sprite.SetPosition(ox, oy, 1);

NFRAMES = 120;
LOOP_START = 84;
shown = -1;
t = 0;

fun name_of (i)
  {
    if (i < 10) return "f00" + i + ".png";
    if (i < 100) return "f0" + i + ".png";
    return "f" + i + ".png";
  }

fun refresh_callback ()
  {
    # ~12 animation frames per second (callback runs ~50 Hz)
    k = Math.Int(t * 12 / 50);
    t++;
    if (k >= NFRAMES)
      {
        # play once, then ping-pong the calm final part
        span = NFRAMES - 1 - LOOP_START;
        m = (k - NFRAMES) % (span * 2);
        if (m < span) k = NFRAMES - 1 - m;
        else k = LOOP_START + (m - span);
      }
    if (k != shown)
      {
        shown = k;
        img = Image(name_of(k));
        sprite.SetImage(img.Scale(nw, nh));
      }
  }
Plymouth.SetRefreshFunction(refresh_callback);

fun quiet_cb (text) { }
Plymouth.SetMessageFunction(quiet_cb);
Plymouth.SetUpdateStatusFunction(quiet_cb);

pw_label = Sprite();
pw_dots = Sprite();
fun password_cb (prompt, bullets)
  {
    img = Image.Text("Password", 0.9, 0.95, 1.0);
    pw_label.SetImage(img);
    pw_label.SetPosition(Window.GetX() + sw / 2 - img.GetWidth() / 2, Window.GetY() + sh * 0.88, 50);
    s = "";
    for (i = 0; i < bullets; i++) s += "*";
    d = Image.Text(s + " ", 0.9, 0.95, 1.0);
    pw_dots.SetImage(d);
    pw_dots.SetPosition(Window.GetX() + sw / 2 - d.GetWidth() / 2, Window.GetY() + sh * 0.88 + 28, 50);
  }
Plymouth.SetDisplayPasswordFunction(password_cb);
fun normal_cb ()
  {
    pw_label.SetOpacity(0);
    pw_dots.SetOpacity(0);
  }
Plymouth.SetDisplayNormalFunction(normal_cb);
